# Copy this file to .env and fill in your values.
# .env is gitignored and should never be committed.

POSTGRES_DB=frauddb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Admin password for the local Seq log viewer (first run)
SEQ_ADMIN_PASSWORD=


# Identity provider (Dex locally). For deployment set these to your real provider.
AUTH_AUTHORITY=http://dex:5556
AUTH_AUDIENCE=fraud-portal
# Local Dex runs over http, so this must be false locally. Set it to true for deployment.
AUTH_REQUIRE_HTTPS_METADATA=false
# Dashboard origin allowed by CORS. Set to the deployed dashboard's https URL.
DASHBOARD_ORIGIN=http://localhost:3000
